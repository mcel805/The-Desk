+@import url('./scoreboard-border.css');
 :root{--desk-bg:#10141f;--desk-panel:#171d29;--desk-border:#2a3343;--desk-muted:#8994aa;--desk-gold:#efc75e;--desk-cyan:#19d0e9;--desk-purple:#963ce6}
 body.crypto-day-desk{background:var(--desk-bg);color:#edf2fa;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;overflow:hidden}
 .crypto-day-desk .topbar{height:44px;padding:0 16px;border-bottom:1px solid var(--desk-border);background:#121722;gap:12px}.crypto-day-desk .home{font-size:13px;letter-spacing:1.5px;color:#f3f6fa}.crypto-day-desk .topbar>.tab:not(.selected),.crypto-day-desk .strategy-mode-picker{display:none}.crypto-day-desk .boundary{font-size:9px;color:#c8ae67;letter-spacing:1px}.crypto-day-desk .top-action{background:#1b2331;font-size:12px}.crypto-day-desk .shell{height:calc(100dvh - 44px);grid-template-columns:minmax(270px,24%) minmax(0,1fr);display:grid;gap:0}.crypto-day-desk .conversation{width:auto;min-width:0;padding:0;background:#131924;border-right:1px solid var(--desk-border);display:flex;flex-direction:column;overflow:hidden}.crypto-day-desk .workspace{min-width:0;min-height:0;background:var(--desk-bg);display:flex;flex-direction:column;position:relative;padding:0;overflow:hidden}.crypto-day-desk .toolbar,.crypto-day-desk .quant-agent-roster,.crypto-day-desk .strategy-agent-scope,.crypto-day-desk .legacy-quant-chat,.crypto-day-desk #traderScoreboard{display:none!important}.crypto-day-desk .quant-codex-host{min-height:220px;flex:1;overflow:hidden;display:flex;flex-direction:column}.crypto-day-desk .quant-codex-host>*{height:100%;min-height:0}.crypto-day-desk .source-line{padding:5px 12px;min-height:23px;font-size:9px;border-bottom:1px solid #222b3b;color:var(--desk-muted);gap:8px}.crypto-day-desk #sourceState{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.crypto-day-desk #sourceCutoff{white-space:nowrap;font-size:9px}.crypto-day-desk .chart-area{flex:1;min-height:0;position:relative;background:#10141f}.crypto-day-desk .chart-grid,.crypto-day-desk .chart-cell,.crypto-day-desk .chart-host{height:100%;min-height:0}.crypto-day-desk .chart-cell{border:0;box-shadow:none}.crypto-day-desk .chart-head{padding:4px 10px;background:#121722;font-size:10px;height:25px;border-bottom:1px solid #202a3a}.crypto-day-desk .bottom-bar{height:26px;min-height:26px;padding:0 10px;gap:10px;font-size:9px;color:#7b879b}.crypto-day-desk .bottom-bar>span:first-of-type{display:none}.crypto-day-desk button{border:1px solid #303b4e;border-radius:5px;background:#1a2231;color:#dce4f2;cursor:pointer;font-size:11px;white-space:nowrap;padding:6px 10px}.crypto-day-desk button:hover{border-color:#607593;background:#263148}.crypto-day-desk button:disabled{opacity:.4;cursor:default}.crypto-day-desk button.selected,.crypto-day-desk .desk-primary{background:#343051;border-color:#756698;color:#fff}.crypto-day-desk input,.crypto-day-desk select{color:#e5ebf7;background:#111823;border:1px solid #313e53;border-radius:4px;font-size:11px;padding:5px 7px;min-width:0}.crypto-day-desk [hidden]{display:none!important}
