//@version=6
indicator(
     "Market Gravity [YinYangAlgorithms]",
     overlay = true,
     max_lines_count = 100,
     max_labels_count = 100,
     max_polylines_count = 10
 )

// Drawing objects that anchor to historical bar_index values are internally
// converted to timestamps. The level-history input can draw up to 3000 bars
// back, so explicitly size only the `time` buffer required by those drawings.
// +1 covers the inclusive offset conversion observed by TradingView.
max_bars_back(time, 3001)

// Market Gravity maps inferred liquidity structures above and below price,
// scores their current attraction, ranks the strongest active magnets, and
// visualizes directional pressure with primary and opposing Gravity paths.
// Gravity scores are relative attraction metrics, not probabilities.

// ~~~~~~~~~~~ INPUTS ~~~~~~~~~~~ //

// Liquidity Detection
pivotLeft = input.int(
     5,
     "Pivot Left Bars",
     minval = 1,
     group = "Advanced - Liquidity Detection",
     tooltip = "Bars to the left used when confirming swing liquidity."
 )

pivotRight = input.int(
     5,
     "Pivot Right Bars",
     minval = 1,
     group = "Advanced - Liquidity Detection",
     tooltip = "Bars to the right required before a swing is confirmed."
 )

clusterATR = input.float(
     0.15,
     "Pool Cluster Distance (ATR)",
     minval = 0.01,
     step = 0.01,
     group = "Advanced - Liquidity Detection",
     tooltip = "Compatible liquidity structures within this ATR distance are clustered into one liquidity pool."
 )

sweepBufferATR = input.float(
     0.05,
     "Sweep Buffer (ATR)",
     minval = 0.0,
     step = 0.01,
     group = "Advanced - Liquidity Detection",
     tooltip = "Price must exceed a liquidity level by this ATR amount before the level is considered swept."
 )

maxAgeBars = input.int(
     1500,
     "Maximum Liquidity Age",
     minval = 100,
     maxval = 5000,
     group = "Advanced - Liquidity Detection"
 )

maxStoredLevels = input.int(
     40,
     "Maximum Stored Levels",
     minval = 10,
     maxval = 100,
     group = "Advanced - Liquidity Detection"
 )

maxTargetDistanceATR = input.float(
     12.0,
     "Maximum Target Distance (ATR)",
     minval = 1.0,
     step = 0.5,
     group = "Advanced - Liquidity Detection"
 )


