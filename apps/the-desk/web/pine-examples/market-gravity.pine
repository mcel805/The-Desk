// ~~~~~~~~~~~ VARIABLES ~~~~~~~~~~~ //

// Display-only typographic point sizes. These affect presentation only.
labelTinyTextSize = int(math.round(7.0 * textSizePercent / 100.0))
labelSmallTextSize = int(math.round(10.0 * textSizePercent / 100.0))

// Gravity Flow / Opposing Gravity badges remain user-scalable, but use a
// smaller relative base so they do not dominate the chart at 150%.
pathBadgeTextSize = int(math.round(6.0 * textSizePercent / 100.0))

tableTinyTextSize = int(math.round(8.0 * textSizePercent / 100.0))
tableSmallTextSize = int(math.round(10.0 * textSizePercent / 100.0))

atr = ta.atr(atrLength)

fastEMA = ta.ema(close, fastEMALength)
slowEMA = ta.ema(close, slowEMALength)

volumeAverage = ta.sma(volume, volumeLength)

pivotHigh = ta.pivothigh(
     high,
     pivotLeft,
     pivotRight
 )

pivotLow = ta.pivotlow(
     low,
     pivotLeft,
     pivotRight
 )

pivotWindow = pivotLeft + pivotRight + 1


// Confirmed higher-timeframe structures.
// [1] + lookahead_on returns the previous completed HTF bar without leaking the developing bar.
[previousDayHigh, previousDayLow] = request.security(
     syminfo.tickerid,
     "1D",
     [high[1], low[1]],
     lookahead = barmerge.lookahead_on
 )

[previousWeekHigh, previousWeekLow] = request.security(
     syminfo.tickerid,
     "1W",
     [high[1], low[1]],
     lookahead = barmerge.lookahead_on
 )

chartTimeframeSeconds = timeframe.in_seconds()
canUsePreviousDay = chartTimeframeSeconds <= timeframe.in_seconds("1D")
canUsePreviousWeek = chartTimeframeSeconds <= timeframe.in_seconds("1W")

newDay = timeframe.change("1D")
newWeek = timeframe.change("1W")

// Persistent liquidity lifecycle states.
LIFECYCLE_FORMING = 0
LIFECYCLE_ACTIVE = 1
LIFECYCLE_APPROACHING = 2
LIFECYCLE_SWEEPING = 3
LIFECYCLE_REJECTED = 4
LIFECYCLE_ACCEPTED = 5
LIFECYCLE_RETIRED = 6

tablePosition =
     tablePositionInput == "Top Right" ? position.top_right :
     tablePositionInput == "Top Left" ? position.top_left :
     tablePositionInput == "Bottom Left" ? position.bottom_left :
     position.bottom_right

