indicator("Agentic - Liquidity", "Agentic - Liquidity", overlay=true, dynamic_requests=true, max_lines_count=500, max_labels_count=400, max_boxes_count=150, max_bars_back=120, calc_bars_count=2400)
// Exact source pool detection and serialization lifted from Wave Court 1.16.
// No Elliott candidates, count engine, master trade plans, or tables.
string G="01 · Source pools"
bool standardSource=input.bool(true,"Standard OHLC source",group=G)
bool useD=input.bool(false,"Daily pools",group=G)
bool use15=input.bool(true,"15M pools",group=G)
bool use5=input.bool(false,"5M pools",group=G)
bool useM=input.bool(false,"1M pools",group=G)
string tfD=input.timeframe("1D","Daily source",group=G)
string tf15=input.timeframe("15","15M source",group=G)
string tf5=input.timeframe("5","5M source",group=G)
bool use4=input.bool(false,"4H pools",group=G)
bool use1=input.bool(true,"1H pools",group=G)
bool use30=input.bool(true,"30M pools",group=G)
string tf4=input.timeframe("240","4H source",group=G)
string tf1=input.timeframe("60","1H source",group=G)
