//@version=6
indicator("Agentic - Key Levels", overlay=true, max_lines_count=60, max_labels_count=60, max_boxes_count=4)
length = input.int(5, "Pivot confirmation bars", minval=2, maxval=30)
keep = input.int(12, "Maximum levels per side", minval=1, maxval=25)
bufferTicks = input.int(2, "Stop buffer ticks", minval=0, maxval=100)
minRR = input.float(2.0, "Minimum reward / risk", minval=0.5, maxval=10)
showLabels = input.bool(true, "Show labels")
showScenario = input.bool(false, "Show hypothetical long risk box")
var highs = array.new_line()
var lows = array.new_line()
var highLabels = array.new_label()
var lowLabels = array.new_label()
ph = ta.pivothigh(high, length, length)
pl = ta.pivotlow(low, length, length)
if barstate.isconfirmed
    if not na(ph)
        array.push(highs, line.new(bar_index-length, ph, bar_index, ph, extend=extend.right, color=color.red))
        array.push(highLabels, label.new(bar_index-length, ph, showLabels ? "Resistance" : "", style=label.style_label_down, color=color.new(color.red, 85), textcolor=color.red, size=size.tiny))
    if not na(pl)
        array.push(lows, line.new(bar_index-length, pl, bar_index, pl, extend=extend.right, color=color.teal))
        array.push(lowLabels, label.new(bar_index-length, pl, showLabels ? "Support" : "", style=label.style_label_up, color=color.new(color.teal, 85), textcolor=color.teal, size=size.tiny))
    if array.size(highs)>0
        for i=array.size(highs)-1 to 0
            if close>line.get_y1(array.get(highs,i))
                line.delete(array.remove(highs,i))
                label.delete(array.remove(highLabels,i))
    if array.size(lows)>0
        for i=array.size(lows)-1 to 0
            if close<line.get_y1(array.get(lows,i))
                line.delete(array.remove(lows,i))
                label.delete(array.remove(lowLabels,i))
    while array.size(highs)>keep
        line.delete(array.shift(highs))
        label.delete(array.shift(highLabels))
    while array.size(lows)>keep
        line.delete(array.shift(lows))
        label.delete(array.shift(lowLabels))
float support=na
float resistance=na
if array.size(lows)>0
    for i=0 to array.size(lows)-1
        price=line.get_y1(array.get(lows,i))
        if price<close and (na(support) or price>support)
            support:=price
if array.size(highs)>0
    for i=0 to array.size(highs)-1
        price=line.get_y1(array.get(highs,i))
        if price>close and (na(resistance) or price<resistance)
            resistance:=price
stop=support-bufferTicks*syminfo.mintick
risk=close-stop
rr=(resistance-close)/risk
var box riskBox=na
var box rewardBox=na
if barstate.islast
    box.delete(riskBox)
    box.delete(rewardBox)
    if showScenario and not na(support) and not na(resistance) and risk>0 and rr>=minRR
        riskBox:=box.new(bar_index,close,bar_index+8,stop,border_color=color.red,bgcolor=color.new(color.red,90))
        rewardBox:=box.new(bar_index,resistance,bar_index+8,close,border_color=color.teal,bgcolor=color.new(color.teal,90))
plot(support,"Nearest support",display=display.data_window)
plot(resistance,"Nearest resistance",display=display.data_window)
