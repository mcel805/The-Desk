//@version=6
// Wave Court v1.14 — compact collision-merged liquidity timeframe tags, 2026-10-08.
// Read USER_GUIDE_v1_14.md before interpreting signals.
// Structural quality is NOT probability. Pivot liquidity is NOT order-book data.
indicator("Wave Court • Seven Timeframe Research v1.14", "Wave Court MTF 1.14", overlay = true, dynamic_requests = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 100, max_bars_back = 120)

// ══════════════════════════════════════════════════════════════════════════════
// 01 · INPUT CONTRACT. Visibility never changes analytical participation.
// ══════════════════════════════════════════════════════════════════════════════
string G_ENGINE = "01 · Engine / source"
string G_TF = "02 · Timeframe participation / weight"
string G_WAVE = "03 · Elliott candidate engine"
string G_VIEW = "04 · Display layers"
string G_LIQ = "05 · Pivot liquidity"
string G_CON = "06 · Shared convergence"
string G_PLAN = "07 · Conditional decision / stops / targets"
string G_PANEL = "08 · Read panel / alerts"
string G_STYLE = "09 · Styling"
string G_MAN = "10 · Manual core primary anchors"
string G_STRUCT = "11 · Micro structure tags"
bool standardSource = input.bool(true, "Use standard OHLC source", group = G_ENGINE, tooltip = "Uses ticker.standard(). Recommended on standard time-based candlesticks. Synthetic chart prices are not execution references.")
int sourceBars = input.int(400, "History requested per source timeframe", minval = 200, maxval = 1200, group = G_ENGINE)
int masterBars = input.int(1200, "1-minute master history", minval = 500, maxval = 6000, group = G_ENGINE, tooltip = "Canonical state window. Larger values increase runtime. All compared charts must use identical settings, source and available history.")
int fastLength = input.int(21, "Trend fast EMA", minval = 2, maxval = 200, group = G_ENGINE, inline = "ema")
int slowLength = input.int(55, "Slow EMA", minval = 3, maxval = 300, group = G_ENGINE, inline = "ema")
int atrLength = input.int(14, "Source ATR length", minval = 2, maxval = 100, group = G_ENGINE)
string coreChoice = input.string("1H", "Core research timeframe", options = ["Daily", "4H", "1H", "30M", "15M", "5M", "1M"], group = G_ENGINE)
string tfD = input.timeframe("1D", "Daily source", group = G_TF, inline = "D")
bool useD = input.bool(true, "Use", group = G_TF, inline = "D")
float weightD = input.float(16, "Weight", minval = 0, group = G_TF, inline = "D")
string tf4 = input.timeframe("240", "4H source", group = G_TF, inline = "4")
bool use4 = input.bool(true, "Use", group = G_TF, inline = "4")
float weight4 = input.float(8, "Weight", minval = 0, group = G_TF, inline = "4")
string tf1 = input.timeframe("60", "1H source", group = G_TF, inline = "1")
bool use1 = input.bool(true, "Use", group = G_TF, inline = "1")
float weight1 = input.float(4, "Weight", minval = 0, group = G_TF, inline = "1")
string tf30 = input.timeframe("30", "30M source", group = G_TF, inline = "30")
bool use30 = input.bool(true, "Use", group = G_TF, inline = "30")
float weight30 = input.float(2, "Weight", minval = 0, group = G_TF, inline = "30")
string tf15 = input.timeframe("15", "15M source", group = G_TF, inline = "15")
bool use15 = input.bool(true, "Use", group = G_TF, inline = "15")
float weight15 = input.float(1, "Weight", minval = 0, group = G_TF, inline = "15")
string tf5 = input.timeframe("5", "5M source", group = G_TF, inline = "5")
bool use5 = input.bool(true, "Use", group = G_TF, inline = "5")
float weight5 = input.float(0.5, "Weight", minval = 0, group = G_TF, inline = "5")
bool useM = input.bool(true, "1M fixed master source · participate", group = G_TF, inline = "M")
float weightM = input.float(0.25, "Weight", minval = 0, group = G_TF, inline = "M")

int minorLen = input.int(2, "Minor pivot strength", minval = 1, maxval = 15, group = G_WAVE, inline = "len")
int midLen = input.int(6, "Intermediate", minval = 2, maxval = 30, group = G_WAVE, inline = "len")
int majorLen = input.int(12, "Major", minval = 3, maxval = 50, group = G_WAVE, inline = "len")
int pivotKeep = input.int(24, "Confirmed swings retained / degree / TF", minval = 8, maxval = 40, group = G_WAVE)
int searchWindows = input.int(8, "Recent candidate windows searched", minval = 1, maxval = 15, group = G_WAVE)
string preference = input.string("Recent + quality", "Candidate ranking", options = ["Recent + quality", "Quality first"], group = G_WAVE)
bool allowTruncation = input.bool(false, "Allow truncated fifth candidates", group = G_WAVE)
bool diagonals = input.bool(true, "Evaluate diagonal geometry", group = G_WAVE)
bool triangles = input.bool(true, "Evaluate triangle geometry", group = G_WAVE)
bool complexABC = input.bool(true, "Show W-X-Y geometry alternate", group = G_WAVE, tooltip = "Only a geometric alternative. Three component corrections are not certified by this label.")
float flatMin = input.float(0.90, "Flat B/A minimum retracement", minval = 0.5, maxval = 1.5, step = 0.01, group = G_WAVE)
float flatRegularMax = input.float(1.05, "Regular flat B/A maximum", minval = 1, maxval = 1.5, step = 0.01, group = G_WAVE)
float projectionLow = input.float(1.0, "Impulse extension lower Fib", minval = 0.1, step = 0.001, group = G_WAVE, inline = "fib")
float projectionHigh = input.float(1.618, "Upper", minval = 0.1, step = 0.001, group = G_WAVE, inline = "fib")
int projectionBars = input.int(12, "Schematic projection horizon in source bars", minval = 2, maxval = 100, group = G_WAVE)

string preset = input.string("Active now", "Display preset", options = ["Active now", "Core + context", "All seven", "HTF", "Scalp", "Setup only"], group = G_VIEW, tooltip = "Controls the timeframe scope for visual layers. The count ladder setting below limits visible wave labels independently; all seven source frames still participate in the analysis.")
string countMode = input.string("Three-level ladder", "Visible Elliott count levels", options = ["Three-level ladder", "Full research"], group = G_VIEW, tooltip = "Three-level ladder shows parent major, chart intermediate and child minor counts. Full research restores every enabled timeframe and degree. Count calculations do not change.")
int activeWindow = input.int(20, "Active geometry window · core bars", minval = 5, maxval = 120, group = G_VIEW)
bool activeCompactLabels = input.bool(false, "Active view · compact latest wave labels", group = G_VIEW, tooltip = "Leave off to show every qualified endpoint of the retained primary and alternate counts on all enabled timeframes.")
bool showWaves = input.bool(true, "Wave labels", group = G_VIEW, inline = "wv")
bool showAlternates = input.bool(true, "Alternate count", group = G_VIEW, inline = "wv")
bool showMajor = input.bool(true, "Major", group = G_VIEW, inline = "deg")
bool showMid = input.bool(true, "Intermediate", group = G_VIEW, inline = "deg")
bool showMinor = input.bool(true, "Minor", group = G_VIEW, inline = "deg")
bool showSwingPath = input.bool(false, "All retained swing paths / unlabeled pivots", group = G_VIEW)
bool showChannels = input.bool(true, "Wick-safe chart channels", group = G_VIEW, inline = "cn")
bool showProjection = input.bool(false, "Conditional projections", group = G_VIEW, inline = "cn")
bool showWaveInvalidation = input.bool(false, "Candidate origin / non-overlap invalidation references", group = G_VIEW)
bool showFib = input.bool(false, "Critical Fib swing lines", group = G_VIEW)
bool showRaw = input.bool(true, "Raw liquidity", group = G_VIEW, inline = "lq")
string rawScope = input.string("1H + 30M + 15M", "Scope", options = ["1H + 30M + 15M", "Core", "HTF + core", "All seven"], group = G_VIEW, inline = "lq")
bool showLiquidityTimeframeTags = input.bool(true, "Small timeframe numbers at liquidity ends", group = G_VIEW, tooltip = "White 8 px labels sit just beyond each active or ended source line. Nearby endpoints merge into one tag such as 60/30; turn this off for the fully text-free view.")
bool showLiquidityPockets = input.bool(false, "Shade liquidity pockets", group = G_VIEW, tooltip = "Off by default for a clean chart. When on, a faint pocket uses its source timeframe color.")
bool showConfluence = input.bool(true, "Shared purple convergence zones", group = G_VIEW)
bool showConfluenceTags = input.bool(false, "Print P-zone tags", group = G_VIEW, tooltip = "Off by default. Purple center segments still identify convergence without repeated P text.")
bool showOtherConvergence = input.bool(false, "Show convergence without a displayed core line", group = G_VIEW, tooltip = "The compact view overlays convergence on a displayed 1H/30M/15M wick level. Turn this on to show all other active zones as short independent purple markers.")
bool colorTrendBars = input.bool(false, "Color bars by completed core EMA context", group = G_VIEW)
bool showD = input.bool(true, "Daily", group = G_VIEW, inline = "frames")
bool show4 = input.bool(true, "4H", group = G_VIEW, inline = "frames")
bool show1 = input.bool(true, "1H", group = G_VIEW, inline = "frames")
bool show30 = input.bool(true, "30M", group = G_VIEW, inline = "frames2")
bool show15 = input.bool(true, "15M", group = G_VIEW, inline = "frames2")
bool show5 = input.bool(true, "5M", group = G_VIEW, inline = "frames2")
bool showM = input.bool(true, "1M", group = G_VIEW, inline = "frames2")

// Batty Clean v1.9.6 has a default aqua EQL path from paired 3/3 lows and
// a separate 5/5 internal pivot path inside a 14/14 external range.
// Wave Court keeps compact cyan rendering and independent strength scoring.
bool structureEnabled = input.bool(true, "Calculate micro structure", group = G_STRUCT, inline = "st")
bool showStructure = input.bool(true, "Show cyan dashes", group = G_STRUCT, inline = "st")
string structureDetector = input.string("Micro structure map", "Detector", options = ["Micro structure map", "Batty equal lows", "Batty internal range", "Reaction pivots"], group = G_STRUCT)
int structureMapPivot = input.int(3, "Map pivot bars on each side", minval = 1, maxval = 12, group = G_STRUCT)
int structurePivot = input.int(5, "Internal pivot bars on each side", minval = 1, maxval = 12, group = G_STRUCT)
int structureExternalPivot = input.int(14, "External swing bars on each side", minval = 2, maxval = 40, group = G_STRUCT)
int structureEqualPivot = input.int(3, "Equal-low pivot bars on each side", minval = 1, maxval = 12, group = G_STRUCT)
int structureEqualATRLength = input.int(200, "Equal-low tolerance ATR length", minval = 20, maxval = 400, group = G_STRUCT)
float structureEqualATRTolerance = input.float(0.10, "Equal-low match tolerance / ATR", minval = 0.01, maxval = 1.0, step = 0.01, group = G_STRUCT)
