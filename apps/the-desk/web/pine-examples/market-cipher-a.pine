//@version=6
// The Desk independent visual/concept reconstruction, not original Market Cipher source.
// Proprietary signal formulas are unavailable. See MARKET-CIPHER.md for every rule.
indicator("Market Cipher A · Desk Reconstruction", shorttitle="Cipher A · Desk", overlay=true, max_labels_count=500)
showRibbon = input.bool(true, "EMA ribbon", group="Ribbon")
source = input.source(close, "Source", group="Ribbon")
bullColor = input.color(#29a8ff, "Bull ribbon", group="Ribbon")
bearColor = input.color(#606d7e, "Bear ribbon", group="Ribbon")
slowColor = input.color(#e6f5ff, "Slow ribbon", group="Ribbon")
showSignals = input.bool(true, "Show reconstructed symbols", group="Signals")
confirmedOnly = input.bool(true, "Signals on completed candles only", group="Signals")
showCircles = input.bool(true, "Green circles", group="Signals")
showTriangles = input.bool(true, "Blue triangles", group="Signals")
showYellowDiamonds = input.bool(true, "Yellow diamonds", group="Signals")
showRedDiamonds = input.bool(true, "Red diamonds", group="Signals")
showBloodDiamonds = input.bool(true, "Blood diamonds", group="Signals")
showRedX = input.bool(true, "Red X", group="Signals")
showYellowX = input.bool(true, "Yellow X", group="Signals")
rsiLength = input.int(14, "RSI length", minval=2, group="Signal calculations")
rsiExtreme = input.int(70, "RSI exhaustion threshold", minval=50, maxval=99, group="Signal calculations")
compression = input.float(0.35, "Ribbon compression / ATR", minval=0.01, step=0.05, group="Signal calculations")
wickRatio = input.float(1.5, "Upper wick / body warning", minval=0.1, step=0.1, group="Signal calculations")
length1 = input.int(5, "EMA 1 length", minval=1, group="Ribbon")
ema1 = ta.ema(source, length1)
length2 = input.int(11, "EMA 2 length", minval=1, group="Ribbon")
ema2 = ta.ema(source, length2)
length3 = input.int(15, "EMA 3 length", minval=1, group="Ribbon")
ema3 = ta.ema(source, length3)
length4 = input.int(18, "EMA 4 length", minval=1, group="Ribbon")
ema4 = ta.ema(source, length4)
length5 = input.int(21, "EMA 5 length", minval=1, group="Ribbon")
ema5 = ta.ema(source, length5)
length6 = input.int(24, "EMA 6 length", minval=1, group="Ribbon")
ema6 = ta.ema(source, length6)
length7 = input.int(28, "EMA 7 length", minval=1, group="Ribbon")
ema7 = ta.ema(source, length7)
length8 = input.int(34, "EMA 8 length", minval=1, group="Ribbon")
ema8 = ta.ema(source, length8)
bull = ema1 >= ema8
ready = not na(ema8) and not na(ta.rsi(source, rsiLength))
signalBar = ready and showSignals and (not confirmedOnly or barstate.isconfirmed)
rsi = ta.rsi(source, rsiLength)
atr = ta.atr(14)
body = math.max(math.abs(close - open), syminfo.mintick)
upperWick = high - math.max(open, close)
ribbonWidth = math.abs(ema1 - ema8)
fastUp = ta.crossover(ema1, ema2)
trendUp = ta.crossover(ema2, ema8)
trendDown = ta.crossunder(ema2, ema8)
fastDown = ta.crossunder(ema1, ema2)
exhaustion = ta.crossunder(rsi, rsiExtreme)
recovery = ta.crossover(rsi, 50)
circle = signalBar and recovery and close > ema8
triangle = signalBar and trendUp
yellowDiamond = signalBar and fastUp and bull
redDiamond = signalBar and fastDown
bloodDiamond = signalBar and fastDown and rsi[1] > rsiExtreme and close < ema4
redX = signalBar and trendDown
yellowX = signalBar and exhaustion and ribbonWidth < atr * compression and upperWick > body * wickRatio
p1 = plot(showRibbon ? ema1 : na, title="EMA 1", color=bull ? color.new(bullColor, 0) : color.new(bearColor, 35), linewidth=1)
p2 = plot(showRibbon ? ema2 : na, title="EMA 2", color=bull ? color.new(bullColor, 8) : color.new(bearColor, 30), linewidth=1)
p3 = plot(showRibbon ? ema3 : na, title="EMA 3", color=bull ? color.new(bullColor, 16) : color.new(bearColor, 25), linewidth=1)
p4 = plot(showRibbon ? ema4 : na, title="EMA 4", color=bull ? color.new(bullColor, 24) : color.new(bearColor, 20), linewidth=1)
p5 = plot(showRibbon ? ema5 : na, title="EMA 5", color=bull ? color.new(bullColor, 32) : color.new(bearColor, 15), linewidth=1)
p6 = plot(showRibbon ? ema6 : na, title="EMA 6", color=bull ? slowColor : color.new(bearColor, 10), linewidth=1)
p7 = plot(showRibbon ? ema7 : na, title="EMA 7", color=bull ? slowColor : color.new(bearColor, 5), linewidth=1)
p8 = plot(showRibbon ? ema8 : na, title="EMA 8", color=bull ? slowColor : color.new(bearColor, 0), linewidth=1)
fill(p1, p8, color=showRibbon ? color.new(bull ? bullColor : bearColor, 86) : na, title="Ribbon shading")
plotshape(circle and showCircles, title="Green circle", style=shape.circle, location=location.belowbar, color=#38ff2e, size=size.tiny)
plotshape(triangle and showTriangles, title="Blue triangle", style=shape.triangleup, location=location.abovebar, color=#5668ff, size=size.tiny)
plotshape(yellowDiamond and showYellowDiamonds, title="Yellow diamond", style=shape.diamond, location=location.abovebar, color=#e5d629, size=size.tiny)
plotshape(redDiamond and not bloodDiamond and showRedDiamonds, title="Red diamond", style=shape.diamond, location=location.abovebar, color=#ff3038, size=size.tiny)
plotshape(bloodDiamond and showBloodDiamonds, title="Blood diamond", style=shape.diamond, location=location.abovebar, color=#ff0033, size=size.tiny)
plotshape(redX and showRedX, title="Red X", style=shape.xcross, location=location.abovebar, color=#ff3038, size=size.tiny)
plotshape(yellowX and showYellowX, title="Yellow X", style=shape.xcross, location=location.abovebar, color=#ffff00, size=size.tiny)
alertcondition(circle or triangle or yellowDiamond, "Cipher A bullish context", "Desk reconstructed Cipher A bullish context on completed candle")
alertcondition(redDiamond or bloodDiamond or redX or yellowX, "Cipher A caution", "Desk reconstructed Cipher A caution on completed candle")
