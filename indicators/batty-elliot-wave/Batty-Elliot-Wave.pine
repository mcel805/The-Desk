bool useMtfAlignment = input.bool(true, "Use higher-timeframe leadership", group=G4, tooltip="Daily leads 4H. Daily and 4H jointly lead 1H and lower. Conflicting or missing parent states suppress active forecasts instead of drawing competing paths.")
string mtfDaily = input.timeframe("1D", "Parent timeframe", group=G4)
string mtfFourHour = input.timeframe("240", "Middle timeframe", group=G4)
int mtfDailyPivot = input.int(4, "Daily pivot confirmation bars", minval=2, maxval=20, group=G4)
int mtfFourHourPivot = input.int(5, "4H pivot confirmation bars", minval=2, maxval=30, group=G4)
bool mtfRequireAgreement = input.bool(true, "Strictly suppress conflicting paths", group=G4, tooltip="On 4H, active paths must follow Daily. On 1H and lower, active paths must follow aligned Daily and 4H states. Historical labels remain evidence; active forecasts are withheld during a conflict.")
bool showMtfContext = input.bool(true, "Show MTF alignment in panel", group=G4)

type Pivot
    int x
    int ts
    float p
    int side
    int known

type Candidate
    array<Pivot> pts
    string family
    int stage
    int degree
    int dir
    float score
    int evidence
    int needed
    float t1
    float t2
    float inv
    int nextDir
    string nextWave
    string key
    string rules
    float trigger = na
    float t3 = na
    float t3Inv = na
    string role = "Primary"

type HNode
    array<Pivot> pts
    int lo
    int hi
    int layer
    string family
    int stage
    int dir
    float merit
    int evidence
    array<int> kids

type Layer
    array<Pivot> pts
    array<int> beginIds
    array<int> endIds

type NodeBucket
    array<int> ids

type HistoryPath
    array<int> ids
    array<int> lefts
    array<int> rights
    float merit

// Keep each traversal node and its display depth in ONE queue entry.
type DrawTask
    int nodeId
    int depth
    bool parentUnresolved

type FrozenPath
    Candidate candidate
    int anchorTime
    int issued
    float origin
    int expires
    string state
    float mfe
    float mae

var array<FrozenPath> frozen = array.new<FrozenPath>()
var array<Candidate> livePair = array.new<Candidate>()
var bool drawingForecast = false
var bool lockAttempted = false
var int actualLockTime = na

type SearchBranch
    array<Pivot> pts
    int lastIndex
    bool skipped

type EvidenceTask
    int nodeId
    int remaining

type Observation
    string key
    int issued
    float target
    float invalid
    int dir
    int expires
    string state

