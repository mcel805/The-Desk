bool useEvidenceGreen = input.bool(false, "Green for evidence-supported counts", group=G2, tooltip="Optional. With the reference hierarchy default, degree colors remain visible. Turn on to make fully evidence-supported labels and their connector lines green.")
color evidenceColor = input.color(#32E6A1, "Evidence-supported count", group=G2)
string GS = "02b · Color and typography"
string colorMode = input.string("Vivid degrees", "Color theme", options=["Vivid degrees", "Direction", "Custom degrees"], group=GS, tooltip="Vivid: light neutral highest degree, blue middle degree, red inner degree. Direction: teal bullish patterns, coral bearish patterns. Colors communicate structure, not certainty.")
string parentText = input.string("Normal", "Parent label size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=GS)
string childText = input.string("Small", "First sublayer label size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=GS)
string fineText = input.string("Small", "Finer sublayer label size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=GS)
string forecastText = input.string("Small", "Forecast label size — compact", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=GS, tooltip="Defaults two Pine size steps below the prior Large setting to keep target and invalidation text out of the price action.")
float labelSpacing = input.float(1.3, "Label spacing multiplier", minval=0.5, maxval=4.0, step=0.1, group=GS)
string countLabelScale = input.string("100%", "Count label scale", options=["100%", "125%", "150%"], group=GS, tooltip="Applies only to historical Elliott labels. Pine has discrete label sizes, so 125% promotes each count label by one size where available.")
bool labelBadges = input.bool(false, "Tinted label badges", group=GS)
int badgeTransparency = input.int(82, "Badge transparency", minval=0, maxval=100, group=GS)
int connectorTransparency = input.int(15, "Wave-line transparency", minval=0, maxval=90, group=GS)
color bullColor = input.color(#00E5A0, "Bullish patterns", group=GS)
color bearColor = input.color(#FF657A, "Bearish patterns", group=GS)
color projectionColor = input.color(#1FE8FF, "Prediction: Path 1", group=GS)
