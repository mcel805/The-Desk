bool showPanel = informationMode != "Off"
string labelMode = input.string("Reference hierarchy", "Wave label style", options=["Reference hierarchy", "Clean", "Degree notation", "Audit"], group=G2, tooltip="Reference hierarchy: light neutral ((I)), blue (i), red i. Clean: letters/numbers only. Degree notation: brackets/roman numerals. Audit: evidence prefixes and question marks. All modes remain provisional; hover for evidence.")
color primaryColor = input.color(#69B8FF, "Largest count", group=G2)
color localColor = input.color(#E6EDF5, "First sublayer", group=G2)
color targetColor = input.color(#72CFC4, "Finer sublayers / targets", group=G2)
