string panelText = input.string("Small", "Panel text size", options=["Tiny", "Small", "Normal", "Large"], group=GS)
bool detailedPanel = informationMode == "Detailed"

string G3 = "03 · Conditional forecasts"
string measurement = input.string("Log", "Fibonacci measurement", options=["Linear", "Log"], group=G3)
bool showLevels = input.bool(true, "Target and invalidation levels", group=G3)
bool showTrigger = input.bool(true, "Candidate trigger line", group=G3, tooltip="Shows the close-based level that confirms the next-wave scenario. A drawn path remains conditional until that trigger is crossed.")
bool showChannel = input.bool(true, "Active impulse channel", group=G3)
