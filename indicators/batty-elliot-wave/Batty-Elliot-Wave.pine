//@version=6
indicator("Batty - Elliot Wave", overlay=true, max_lines_count=500, max_labels_count=500, max_bars_back=5000)
// v0.6.6-visible-count-fallback | FULL-HISTORY INTERPRETATIONS | Independent strict Elliott implementation.
// History is reconstructed from closed bars. Counts can be revised; labels are back-anchored.
// A heuristic rank is NOT a probability. Unsupported subdivisions remain UNKNOWN.
string G1 = "01 · Analysis — independent of chart zoom"
int baseLen = input.int(5, "Pivot confirmation bars", minval=2, maxval=30, group=G1)
int startTime = input.time(0, "Analysis start (0 = all loaded bars)", group=G1)
int endTime = input.time(0, "Frozen cutoff (0 = latest closed bar)", group=G1)
string bias = input.string("Neutral", "Root pattern search", options=["Neutral", "Impulse", "Zigzag"], group=G1)
int pivotCapacity = input.int(3000, "Retained pivots — cap is disclosed", minval=300, maxval=5000, group=G1)
int rootLayer = input.int(0, "Largest layer (0 = automatic; 1 = finest)", minval=0, maxval=8, group=G1)
bool showParentABC = input.bool(true, "Show largest A-B-C context", group=G1, tooltip="Display only. Children and analysis remain available when the context is hidden.")
bool searchChildren = input.bool(true, "Search inside selected parent legs", group=G1)
int childBudget = input.int(6000, "Child-search edge budget per rebuild", minval=500, maxval=20000, group=G1)
int spanBudget = input.int(160, "Maximum child-search edges per span", minval=32, maxval=2000, group=G1, tooltip="Keeps one difficult parent leg from consuming the entire rebuild budget. A capped span remains unresolved, not invalid.")
bool showLocalCandidates = input.bool(false, "Show local candidates inside unresolved parents", group=G1, tooltip="Optional diagnostic overlay. These are not established children of a parent count.")
bool showUnresolvedContext = input.bool(true, "Show unresolved parent geometry", group=G1, tooltip="When no supported local run exists, draw available parent segments in gray with ? labels. This is geometry only, not a validated Elliott count.")
bool showProvisionalCandidates = input.bool(true, "Show provisional child counts", group=G1, tooltip="Shows one lower-degree count under an unresolved parent so the chart remains readable. These labels are geometric hypotheses, not evidence-supported Elliott subdivisions.")
int provisionalChildLayers = input.int(2, "Provisional child layers", minval=0, maxval=2, group=G1, tooltip="1 shows the next lower degree only. Deeper children still require parent support unless you raise this setting. Keeping it at 1 avoids a cluttered raw-candidate chart.")
int regroupSpan = input.int(3, "Maximum pivot step for regrouping", options=[1, 3, 5], group=G1, tooltip="1 = original consecutive anchors. 3 or 5 permits internal swings within a wave. Search is bounded and incomplete; hard rules still apply.")
int searchBudget = input.int(12000, "Regrouping work budget per rebuild", minval=1000, maxval=30000, group=G1)
bool requireEvidence = input.bool(true, "Require subdivision evidence for main counts", group=G1, tooltip="Default strict promotion gate. Missing evidence leaves the parent unresolved. Turn off only for geometric diagnostics; not full Elliott validation.")
int evidenceDepth = input.int(1, "Required child generations", minval=1, maxval=2, group=G1, tooltip="1 verifies complete children at every existing leg; 2 also verifies their children. Finer untested generations remain UNKNOWN.")
int parentBudget = input.int(96, "Maximum parent candidates to enrich", minval=16, maxval=256, group=G1)
bool showRejectionAudit = input.bool(false, "Print sampled rejection audit to Pine Logs", group=G1, tooltip="Bounded sample of rejected anchor paths plus unsupported parent candidates. No log upload or external request.")
int pick = input.int(1, "History interpretation: 1 primary, 2–4 alternates", minval=1, maxval=4, group=G1)
// One connected hierarchy always includes its parent context and attached children.
int localBars = input.int(300, "Recent structure window, bars", minval=60, maxval=1000, group=G1)
bool structureFallback = input.bool(false, "Separate structure scenarios (replaces EW display explicitly)", group=G1)
int rangeBars = input.int(20, "Structure trigger range, closed bars", minval=5, maxval=100, group=G1)
float targetAtrLimit = input.float(8.0, "Local Elliott target distance limit, ATR", minval=2, maxval=30, group=G1)
string G2 = "02 · Display — does NOT change the analyzed history"
int visibleLayers = input.int(3, "Visible layers including largest", minval=1, maxval=8, group=G2)
string historyRender = input.string("Connected interpretation", "Historical count rendering — clean default", options=["Connected interpretation", "All candidate swings"], group=G2, tooltip="Connected interpretation draws the selected primary path and is the clean default. All candidate swings is a diagnostic mode that can show overlapping hypotheses.")
string viewMode = input.string("Visible chart", "Show annotations in", options=["Visible chart", "All analyzed history", "Custom dates"], group=G2)
int displayStart = input.time(0, "Display from (custom dates only)", group=G2)
int displayEnd = input.time(0, "Display through (0 = latest)", group=G2)
int labelBudget = input.int(240, "Label budget — parents have priority", minval=60, maxval=450, group=G2)
bool connectors = input.bool(false, "Show count connectors", group=G2, tooltip="Optional lines joining confirmed count pivots. Labels remain visible when these lines are off.")
bool showUnknown = input.bool(false, "Unresolved sections / missing subdivisions", group=G2)
