int forecastDegree = input.int(0, "Forecast degree (0 = largest admissible)", minval=0, maxval=8, group=G3)
bool lockPaths = input.bool(false, "LOCK paths at selected time", group=G3)
int lockTime = input.time(0, "Lock time (required when LOCK is on)", group=G3, tooltip="First eligible bar closing at or after this time. Uses only information known at that close. Keep symbol, timeframe, data and analysis settings unchanged to reproduce. Zero does not lock.")
