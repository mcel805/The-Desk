//@version=5
// Probability Based Batty Liquidity v1
// Built from BATTY_LIQUIDITY_SWINGS_SPARKY_FULL_MERLIN_NO_STATE_REALTIME.pine
// Keeps SPARKY core zone logic as source of truth; adds Merlin measured HTF sweep probabilities from 2026-06-21 back-measurement.
indicator("Batty Clean Zone View v1.9.6 - Bias Draw Lines Default Off", shorttitle = "Batty Clean v1.9.6", overlay = true, max_lines_count = 180, max_labels_count = 100, max_boxes_count = 20)

//------------------------------------------------------------------------------
// Settings
//------------------------------------------------------------------------------
length = input.int(14, "Pivot Lookback", minval = 1)

area = input.string("Wick Extremity", "Swing Area", options = ["Wick Extremity", "Full Range"])

intraPrecision = input.bool(false, "Intrabar Precision", inline = "intrabar")
intrabarTf = input.timeframe("1", "", inline = "intrabar")

filterOptions = input.string("Count", "Filter Areas By", options = ["Count", "Volume"], inline = "filter")
filterValue = input.float(0, "", minval = 0, inline = "filter")

// Style
showTop = input.bool(true, "Swing High", inline = "top", group = "Style")
topCss = input.color(color.red, "", inline = "top", group = "Style")
topAreaCss = input.color(color.new(color.red, 50), "Area", inline = "top", group = "Style")

showBtm = input.bool(true, "Swing Low", inline = "btm", group = "Style")
btmCss = input.color(color.teal, "", inline = "btm", group = "Style")
btmAreaCss = input.color(color.new(color.teal, 50), "Area", inline = "btm", group = "Style")

labelSize = input.string("Small", "Labels Size", options = ["Tiny", "Small", "Normal", "Large", "Huge"], group = "Style")
extendUnbrokenLines = input.bool(true, "Extend Unbroken Lines", group = "Style")
showLiquidityTags = input.bool(true, "Show BSL/SSL Tags", group = "Style")
showZoneLifecycleStyling = input.bool(true, "Broken line lifecycle styling", group = "Style")
brokenZoneColor = input.color(color.rgb(180, 180, 180), "Current broken line color", group = "Style")
historicalZoneColor = input.color(color.rgb(180, 180, 180), "Older broken line color", group = "Style")
historicalZoneOpacity = input.int(50, "Older broken line opacity", minval = 0, maxval = 95, group = "Style")
historicalZoneBoxOpacity = input.int(88, "Historical broken zone fill opacity", minval = 50, maxval = 100, group = "Style")


// Clean Zone View
const string cleanViewGroup = "Clean Zone View"
zoneViewMode = input.string("Trade", "Zone View Mode", options = ["Trade", "Clean", "Detail", "Diagnostic"], group = cleanViewGroup)
cleanTradePreset = input.string("Auto", "Trade View Preset", options = ["Auto", "1H Battlefield", "30M Battlefield", "5M Timing", "1M Execution", "Manual"], group = cleanViewGroup)
cleanShowCurrentTfZones = input.bool(false, "Show current-chart historical zones (heavy)", group = cleanViewGroup)
cleanShowMtfOverlay = input.bool(true, "Show right-side active HTF/LTF map", group = cleanViewGroup)
cleanMtfZonesPerSide = input.int(1, "Active map zones per side/timeframe", minval = 1, maxval = 2, group = cleanViewGroup)
cleanShow1h = input.bool(true, "Manual: Show T1 1H MAP", group = cleanViewGroup)
cleanShow30m = input.bool(true, "Manual: Show T2 30M MAP", group = cleanViewGroup)
cleanShow5m = input.bool(true, "Manual: Show T3 5M MAP", group = cleanViewGroup)
cleanShow1m = input.bool(false, "Reserved: Show 1M MAP", group = cleanViewGroup)
cleanShowLowerTfMapOn1h = input.bool(true, "Auto: Show T2/T3 MAP on 1H chart", group = cleanViewGroup)
cleanMapLabelSize = input.string("Small", "Active map label size (50% larger)", options = ["Tiny", "Small", "Normal", "Large", "Huge"], group = cleanViewGroup)
cleanOverlayBars = input.int(35, "Active map projection bars", minval = 10, maxval = 100, group = cleanViewGroup)
cleanHideVolumeInTradeView = input.bool(true, "Hide raw volume text except Diagnostic", group = cleanViewGroup)
cleanCompactNativeLabels = input.bool(true, "Compact native labels: External/Internal -> EXT/INT", group = cleanViewGroup)
cleanNativeProbInTrade = input.bool(true, "Show native probabilities in Trade/Clean mode", group = cleanViewGroup)
cleanFadeTouchedZones = input.bool(true, "Fade touched/swept active map zones", group = cleanViewGroup)
cleanShowMapLabelPrefix = input.bool(true, "Prefix active-map labels with MAP", group = cleanViewGroup)
cleanShowSetupTierPrefix = input.bool(true, "Prefix active-map labels with T1/T2/T3", group = cleanViewGroup)
cleanShowSpikePrefix = input.bool(true, "Prefix active-map labels with SPIKE", group = cleanViewGroup)
cleanHideMapOnChartTf = input.bool(true, "Hide active map when it matches chart timeframe", group = cleanViewGroup)
cleanMapLineStyleInput = input.string("Dashed", "Active map line style", options = ["Dashed", "Dotted", "Solid"], group = cleanViewGroup)
cleanHtfBslColor = input.color(color.rgb(255, 77, 91), "HTF BSL color", group = cleanViewGroup)
cleanHtfSslColor = input.color(color.rgb(0, 180, 130), "HTF SSL color", group = cleanViewGroup)
cleanLtfBslColor = input.color(color.rgb(255, 150, 60), "LTF BSL color", group = cleanViewGroup)
cleanLtfSslColor = input.color(color.rgb(0, 190, 220), "LTF SSL color", group = cleanViewGroup)

// Shadow Target / Invalidation Lines
const string shadowLinesGroup = "Shadow Target / Invalidation Lines"
shadowMode = input.string("Auto Light", "Shadow Mode", options = ["Auto Light", "Manual"], group = shadowLinesGroup)
shadowManualBias = input.string("WAIT", "Manual Bias", options = ["WAIT", "LONG-WATCH", "SHORT-WATCH"], group = shadowLinesGroup)
shadowManualBsl = input.float(0.0, "Manual Nearest BSL", step = 0.25, group = shadowLinesGroup)
shadowManualSsl = input.float(0.0, "Manual Nearest SSL", step = 0.25, group = shadowLinesGroup)
shadowManualInvalidation = input.float(0.0, "Manual Invalidation", step = 0.25, group = shadowLinesGroup)
shadowManualTarget = input.float(0.0, "Manual Target", step = 0.25, group = shadowLinesGroup)
shadowAutoLookback = input.int(20, "Auto Swing Lookback", minval = 3, maxval = 100, group = shadowLinesGroup)
shadowSweepBufferTicks = input.int(1, "Sweep Buffer Ticks", minval = 0, maxval = 50, group = shadowLinesGroup)
showShadowTargetLine = input.bool(true, "Show Shadow Target Line", group = shadowLinesGroup)
showShadowInvalidationLine = input.bool(true, "Show Shadow Invalidation Line", group = shadowLinesGroup)
showOnlyActiveShadowLines = input.bool(false, "Only Draw Active Shadow Setup", group = shadowLinesGroup)
shadowLineOpacity = input.int(5, "Line Opacity", minval = 0, maxval = 95, group = shadowLinesGroup)
shadowTargetColor = input.color(color.aqua, "Target Line", group = shadowLinesGroup)
shadowInvalidationColor = input.color(color.orange, "Invalidation Line", group = shadowLinesGroup)

// Probability Profile / Merlin Model
const string probabilityGroup = "Probability Profile"
probViewMode = input.string("All Zones + Prob States", "View Mode", options = ["All Zones + Prob States", "High Probability Only"], group = probabilityGroup)
showProbabilityTiers = input.bool(true, "Show Probability A/B/C Tiers", group = probabilityGroup)
showCleanMeasuredZoneTags = input.bool(true, "Clean Zone Tags: SIDE TYPE TIER PROB", group = probabilityGroup)
probTierAPlusThreshold = input.float(78.0, "Tier A+ Probability %", minval = 0, maxval = 100, group = probabilityGroup)
probTierAThreshold = input.float(68.0, "Tier A Probability %", minval = 0, maxval = 100, group = probabilityGroup)
probTierBThreshold = input.float(58.0, "Tier B Probability %", minval = 0, maxval = 100, group = probabilityGroup)
probTierCThreshold = input.float(48.0, "Tier C Probability %", minval = 0, maxval = 100, group = probabilityGroup)
probHighProbMinimumTier = input.string("A", "High Probability Only: Minimum Tier", options = ["A+", "A", "B"], group = probabilityGroup)
probGuideMode = input.string("High-prob zones only", "Stop/Target Micro-Lines", options = ["Off", "High-prob zones only", "All measured zones"], group = probabilityGroup)
probGuideBars = input.int(10, "Stop/Target Projection Bars", minval = 2, maxval = 50, group = probabilityGroup)
probGuideStopBufferTicks = input.int(2, "Stop Buffer Ticks", minval = 0, maxval = 50, group = probabilityGroup)
probGuideLineOpacity = input.int(20, "Stop/Target Line Opacity", minval = 0, maxval = 95, group = probabilityGroup)
probGuideStopColor = input.color(color.rgb(220, 80, 80), "Stop Micro-Line", group = probabilityGroup)
probGuideTargetColor = input.color(color.rgb(80, 210, 160), "Target Micro-Line", group = probabilityGroup)
probHighlightTopTier = input.bool(false, "White Highlight A/A+ Measured Labels", group = probabilityGroup)
probTopTierBgColor = input.color(color.white, "A+ Highlight Background", group = probabilityGroup)
probTopTierTextColor = input.color(color.black, "A+ Highlight Text", group = probabilityGroup)
probMinSamples = input.int(30, "Minimum Samples For Measured Tier", minval = 1, maxval = 10000, group = probabilityGroup)
probModelVersion = input.string("Merlin Probability Zones v1.9.6: class-conditioned edge plus optional running Bias/Draw overlays default OFF", "Probability Model Version", group = probabilityGroup)
probFallbackBsl = input.float(52.0, "Fallback BSL Probability %", minval = 0, maxval = 100, group = probabilityGroup)
probFallbackSsl = input.float(52.0, "Fallback SSL Probability %", minval = 0, maxval = 100, group = probabilityGroup)
probMeasuredOnly = input.bool(false, "Hide Probability When Samples Are Low", group = probabilityGroup)


// Internal Liquidity
const string internalGroup = "Internal Liquidity"
showInternalLiquidity = input.bool(true, "Show Internal Liquidity", group = internalGroup)
internalLength = input.int(5, "Internal Pivot Lookback", minval = 1, group = internalGroup)
internalDisplayMode = input.string("Present", "Display Mode", options = ["Present", "Historical"], group = internalGroup)
internalBslColor = input.color(color.orange, "BSL INT", group = internalGroup)
internalSslColor = input.color(color.aqua, "SSL INT", group = internalGroup)
internalLineStyle = input.string("Dotted", "Line Style", options = ["Dotted", "Dashed", "Solid"], group = internalGroup)

// Valid Liquidity Points
const string validLiquidityGroup = "Valid Liquidity Points"
showValidLiquidityPoints = input.bool(true, "Show Valid Liquidity Points", group = validLiquidityGroup)
showPreviousDayLiquidity = input.bool(false, "Previous Day High/Low", group = validLiquidityGroup)
showPreviousWeekLiquidity = input.bool(false, "Previous Week High/Low", group = validLiquidityGroup)
showHtfLiquidity = input.bool(false, "Current HTF Range High/Low", group = validLiquidityGroup)
validHtf = input.timeframe("60", "HTF Source", group = validLiquidityGroup)
validHtfTag = input.string("1H", "HTF Tag", group = validLiquidityGroup)
