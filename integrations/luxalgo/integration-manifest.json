{
  "name": "count-desk-open-source-integration",
  "version": 1,
  "purpose": "Credential-free capability contract for Count Desk's open-source trading stack.",
  "sourceManifest": "integrations/open-source/UPSTREAMS.md",
  "sourceSnapshots": [
    "integrations/open-source/trade-journal",
    "integrations/open-source/edge-stats",
    "integrations/open-source/mcp-server",
    "integrations/open-source/broker-sdk"
  ],
  "runtime": {
    "mcpPackage": "@count-desk/open-source-mcp",
    "mcpVersion": "0.1.0",
    "brokerSdkPackage": "@luxalgo/broker-sdk (fork source vendored locally)",
    "brokerSdkVersion": "0.5.1",
    "mcpBuild": "npm run mcp:build",
    "mcpProbe": "npm run mcp:probe",
    "mcpRuntimeArtifact": "integrations/open-source/mcp-server/dist/index.js"
  },
  "defaults": {
    "readOnly": true,
    "paperOnly": true,
    "credentialsInBrowser": false,
    "orderRouting": false,
    "executionRelay": false,
    "liveClaims": false
  },
  "surfaces": {
    "mcp": {
      "enabledBy": "BATTY_LUXALGO_MCP_ENABLED=1",
      "authorizationRequired": false,
      "allowlistOwnedBy": "count-dashboard/server.py:LUXALGO_MCP_TOOLS",
      "writes": "disabled"
    },
    "brokerSdk": {
      "catalog": "integrations/luxalgo/broker-catalog.mjs",
      "accountsAndPositions": "read_only_after_provider_credentials_and_paper_scope",
      "orderRouting": "disabled"
    },
    "tradeJournal": {
      "canonicalLocalSurface": "Count Desk journal routes and vendored Trade Journal source",
      "authorizationRequired": false,
      "luxAlgoWriteThrough": "disabled",
      "brokerImport": "read_only_after_source_rights_and_credentials"
    },
    "edgeStats": {
      "mode": "read_only_paper_gate",
      "sourceSnapshot": "integrations/open-source/edge-stats",
      "requiredProvenance": ["source", "window", "sampleSize", "confidenceInterval", "freshness", "uncertainty"],
      "liveClaims": "disabled"
    },
    "optionalTools": {
      "propFirmSim": "paper_only",
      "marketTrackers": "public_record_read_only",
      "whaleOptions": "blocked_until_authorized_feed",
      "tradeRelay": "disabled"
    }
  }
}
