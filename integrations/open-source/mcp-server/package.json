{
  "name": "@count-desk/open-source-mcp",
  "version": "0.1.0",
  "description": "Count Desk-owned read-only MCP server built from open-source trading components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LuxAlgo/luxalgo-mcp-server"
  },
  "type": "module",
  "bin": {
    "count-desk-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "agents",
    "technical analysis",
    "technical indicators",
    "charting",
    "finance",
    "trading",
    "prop firms",
    "prop trading",
    "funded accounts",
    "trading challenges",
    "monte-carlo",
    "simulation",
    "research",
    "knowledge-base",
    "open-data",
    "claude",
    "ai",
    "broker",
    "brokerage",
    "portfolio",
    "congress trades",
    "insider trading",
    "sec edgar",
    "lobbying",
    "government contracts",
    "public records"
  ],
  "author": "LuxAlgo",
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "start:http": "node dist/entries/node-http.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.api.json",
    "test": "npm run build && node test/countdesk-surface.mjs",
    "test:upstream": "node test/smoke.mjs",
    "test:http": "node test/smoke.mjs --http http://localhost:3333/mcp",
    "test:parity": "node test/parity.mjs",
    "test:trackers": "node test/trackers-check.mjs"
  },
  "dependencies": {
    "@luxalgo/broker-sdk": "^0.5.0",
    "@luxalgo/prop-firm-sim-core": "1.2.1",
    "@luxalgo/prop-firm-sim-mcp": "1.3.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@posthog/mcp": "^0.13.0",
    "jose": "^6.2.12",
    "mcp-handler": "^2.1.1",
    "posthog-node": "^5.51.4",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
